# MAMP MySQL connection (use the port and password configured in your MAMP app).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_existing_database_name
DB_USER=root
DB_PASSWORD=your_mamp_mysql_password
DB_SSL=false

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
